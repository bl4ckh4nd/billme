COMPOSE_PROJECT_NAME=billme-server-mode

# PostgreSQL
BILLME_POSTGRES_DB=billme
BILLME_POSTGRES_USER=billme
BILLME_POSTGRES_PASSWORD=
# Optional absolute host path for PostgreSQL data instead of the named volume.
# Useful on Podman setups where the container store lives on a filesystem that
# does not support PostgreSQL's permission changes on local volumes.
BILLME_POSTGRES_DATA_DIR=
# Optional container user override for PostgreSQL, for example 70:70 on
# rootless Podman when using a bind-mounted data directory prepared with
# `podman unshare chown -R 70:70 <dir>`.
BILLME_POSTGRES_RUN_AS=

# Fastify API
BILLME_BIND_ADDRESS=127.0.0.1
BILLME_API_PORT=3100
# Required in production: the public HTTPS API URL served by the reverse proxy.
# Leave blank only for local loopback development.
BILLME_PUBLIC_API_URL=
BILLME_SESSION_SECRET=
BILLME_RENDER_SECRET=
BILLME_SERVER_API_IMAGE=ghcr.io/bl4ckh4nd/billme/server-api:latest

# Browser shells
BILLME_WEB_PORT=4175
BILLME_WEB_PRO_PORT=4176
BILLME_SERVER_WORKER_IMAGE=ghcr.io/bl4ckh4nd/billme/server-worker:latest
BILLME_WEB_IMAGE=ghcr.io/bl4ckh4nd/billme/web:latest
BILLME_WEB_PRO_IMAGE=ghcr.io/bl4ckh4nd/billme/web-pro:latest

# Optional platform administration and server-side portal polling
BILLME_PLATFORM_ADMIN_EMAIL=
BILLME_PLATFORM_ADMIN_PASSWORD=
BILLME_PLATFORM_SESSION_SECRET=
# Comma-separated HTTPS origins allowed for server-worker portal polling.
BILLME_PORTAL_ALLOWED_ORIGINS=

# Worker schedule tuning
WORKER_LOG_LEVEL=info
WORKER_RECURRING_INTERVAL_MS=900000
WORKER_DUNNING_INTERVAL_MS=900000
WORKER_EMAIL_QUEUE_INTERVAL_MS=60000
WORKER_PORTAL_SYNC_INTERVAL_MS=60000
WORKER_MAINTENANCE_INTERVAL_MS=86400000
WORKER_RECEIPT_INTERVAL_MS=15000
WORKER_DOCUMENT_RENDER_INTERVAL_MS=10000
WORKER_MOBILE_PUSH_INTERVAL_MS=15000
WORKER_RUN_ONCE=0

# Optional outbound email secrets
SMTP_PASSWORD=
RESEND_API_KEY=
