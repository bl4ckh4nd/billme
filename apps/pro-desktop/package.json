    "@billme/desktop-core": "workspace:*",
    "@billme/desktop-designer": "workspace:*",
    "@billme/desktop-renderer": "workspace:*",
    "@billme/desktop-services": "workspace:*",
    "@billme/desktop-utils": "workspace:*",
    "@billme/embedded-server-runtime": "workspace:*",
    "@billme/finance-intelligence": "workspace:*",
    "@billme/server-core": "workspace:*",
    "@billme/server-data": "workspace:*",
    "@billme/ui": "workspace:*",
    "@electric-sql/pglite": "0.5.5",
    "@tanstack/react-query": "^5.90.19",
    "@tanstack/react-router": "^1.153.1",
    "electron-updater": "^6.8.3",
    "iconv-lite": "^0.6.3",
    "keytar": "^7.9.0",
    "lucide-react": "^0.562.0",
    "nodemailer": "^6.9.15",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "uuid": "^13.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.19.7",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^37.10.3",
    "electron-builder": "26.7.0",
    "electron-vite": "^4.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.1"
