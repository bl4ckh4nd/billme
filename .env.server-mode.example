COMPOSE_PROJECT_NAME=billme-server-mode

# PostgreSQL
BILLME_POSTGRES_DB=billme
BILLME_POSTGRES_USER=billme
BILLME_POSTGRES_PASSWORD=change-me
BILLME_POSTGRES_PORT=5432
# Optional absolute host path for PostgreSQL data instead of the named volume.
# Useful on Podman setups where the container store lives on a filesystem that
# does not support PostgreSQL's permission changes on local volumes.
BILLME_POSTGRES_DATA_DIR=
# Optional container user override for PostgreSQL, for example 70:70 on
# rootless Podman when using a bind-mounted data directory prepared with
# `podman unshare chown -R 70:70 <dir>`.
BILLME_POSTGRES_RUN_AS=

# Fastify API
BILLME_API_PORT=3100
BILLME_PUBLIC_API_URL=http://localhost:3100
# Required. Minimum 32 characters — the API refuses to start otherwise.
# Generate one with: openssl rand -hex 32
BILLME_SESSION_SECRET=replace-with-a-long-random-secret
# Required. The web app asks for it ("Einrichtungscode") when the first account is created,
# so nobody who finds a fresh instance first can claim it. Generate one with: openssl rand -hex 16
BILLME_SETUP_TOKEN=replace-with-a-setup-code
# Where people reach the web apps. `billme login` prints a link to them; without these it only shows the code,
# to be typed in under Einstellungen → System → CLI-Zugriff.
BILLME_PUBLIC_WEB_URL=http://localhost:4175
BILLME_PUBLIC_WEB_PRO_URL=http://localhost:4176

# Optional Pro document-evidence VLM (the key stays server-side; never expose it to clients).
OPENROUTER_API_KEY=
OPENROUTER_VLM_MODEL=google/gemini-3.7-flash
OPENROUTER_VLM_MODELS=google/gemini-3.7-flash
OPENROUTER_VLM_TIMEOUT_MS=45000

# Offer portal publishing (required by the server-mode compose stack).
# Generate one with: openssl rand -hex 32
BILLME_PORTAL_PUBLISH_API_KEY=replace-with-a-long-random-portal-key
# Where the offer portal is reachable; the API sends the portal key nowhere else.
BILLME_PUBLIC_PORTAL_URL=http://localhost:3001

# Browser shells
BILLME_WEB_PORT=4175
BILLME_WEB_PRO_PORT=4176

# Worker schedule tuning
WORKER_LOG_LEVEL=info
WORKER_RECURRING_INTERVAL_MS=900000
WORKER_DUNNING_INTERVAL_MS=900000
WORKER_EMAIL_QUEUE_INTERVAL_MS=60000
WORKER_PORTAL_SYNC_INTERVAL_MS=60000
WORKER_MAINTENANCE_INTERVAL_MS=86400000
WORKER_RUN_ONCE=0

# Optional outbound email secrets. They are shared by every workspace, so the
# password is only ever sent to SMTP_HOST; a workspace whose settings name another
# SMTP host cannot send with it. The portal key likewise only goes to
# BILLME_PUBLIC_PORTAL_URL.
SMTP_HOST=
SMTP_PASSWORD=
RESEND_API_KEY=
