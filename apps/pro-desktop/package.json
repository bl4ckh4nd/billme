  },
  "type": "module",
  "packageManager": "pnpm@10.1.0",
  "main": "dist/main/index.js",
  "scripts": {
    "postinstall": "node scripts/rebuild-electron.mjs",
    "rebuild:native": "node scripts/rebuild-electron.mjs",
